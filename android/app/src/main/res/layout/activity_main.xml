<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Splash loading & terminal connection dashboard -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/bg_dark">

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminateTint="@color/theme_teal" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/server_starting"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnShowDiagLogs"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="[查看运行诊断与引擎日志]"
            android:textColor="#a0b5ad"
            android:textSize="11sp" />

        <!-- Fallback action buttons (shown if local server not found or connection failed) -->
        <LinearLayout
            android:id="@+id/layoutFailedActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <Button
                android:id="@+id/btnQuickConnectLan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/theme_teal"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:text="重启手机本地引擎" />

            <Button
                android:id="@+id/btnDirectSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/card_bg"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:text="局域网与画质设置" />

            <Button
                android:id="@+id/btnRetryConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/card_bg"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:text="重试连接" />
        </LinearLayout>
    </LinearLayout>

    <!-- No floating native button here: an overlay at top|end lands on the page's own 玩法说明 button. The shell's
         settings now live in the in-game 设置 → 本机服务 section, reached through the AndroidNative bridge. -->

</FrameLayout>
